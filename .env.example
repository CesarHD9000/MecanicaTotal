# ============================================================================
# Variables de entorno — copiar a `.env` y rellenar con los valores reales
# Project Settings → API en el panel de Supabase
# ============================================================================

# URL del proyecto (https://<referencia>.supabase.co)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública "anon" / "publishable". NUNCA la clave "service_role".
SUPABASE_ANON_KEY=tu-anon-key-aqui
