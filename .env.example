# ============================================================================
# Variables de entorno — copiar a `.env` y rellenar con los valores reales
# Project Settings → API en el panel de Supabase
# ============================================================================

# URL del proyecto (https://<referencia>.supabase.co)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave PÚBLICA. Vale cualquiera de los dos formatos:
#   · nueva  → sb_publishable_...   (Settings → API Keys)
#   · legacy → JWT que empieza por eyJ con role "anon"
# NUNCA la clave privada: "service_role" (JWT) ni "sb_secret_...".
# Esta clave viaja al navegador: lo que protege los datos es la RLS, no el secreto.
SUPABASE_ANON_KEY=tu-anon-key-aqui

# ----------------------------------------------------------------------------
# Analítica (opcional) — Cloudflare Web Analytics
# ----------------------------------------------------------------------------
# Token del beacon. Se obtiene en el panel de Cloudflare:
#   Analytics → Web Analytics → Add a site → copiar el token del snippet.
# Si se deja vacío, analytics.js no carga ningún beacon y el sitio no hace
# peticiones a terceros. No usa cookies: no requiere banner de consentimiento.
CF_ANALYTICS_TOKEN=
